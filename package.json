{
  "name": "@kontourai/datum",
  "version": "0.8.1",
  "description": "Portfolio AI provider/model registry: define providers, models, roles once; resolve which backend, which model, whose key, what base URL. Never makes model calls.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/datum.git"
  },
  "homepage": "https://github.com/kontourai/datum#readme",
  "bugs": {
    "url": "https://github.com/kontourai/datum/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "datum": "bin/datum.mjs"
  },
  "files": [
    "dist/src/",
    "bin/",
    "datum.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:pack": "node scripts/check-package-contents.mjs",
    "check:decisions": "npx -y --dry-run=false --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus decisions check --base ${DECISIONS_BASE:-origin/main}",
    "gen:decisions-index": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus decisions index",
    "verify": "npm run check:decisions && npm run typecheck && npm test && npm run check:pack",
    "workflow:sidecar": "flow-agents-workflow-sidecar",
    "workflow:validate-artifacts": "flow-agents-validate-artifacts",
    "docs:check": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus check",
    "docs:build": "npx -y --package=https://codeload.github.com/kontourai/corpus/tar.gz/08c62ccd72880ff4bd4c378ae252ad437b4b4fb5 -- corpus build"
  },
  "dependencies": {
    "@kontourai/bearing": "0.4.0"
  },
  "devDependencies": {
    "@kontourai/flow-agents": "9.1.0",
    "@kontourai/veritas": "1.11.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
